        "parameters": [
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional start filter (YYYY-MM-DD)",
              "title": "Start Date"
            },
            "description": "Optional start filter (YYYY-MM-DD)"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optional end filter (YYYY-MM-DD)",
              "title": "End Date"
            },
            "description": "Optional end filter (YYYY-MM-DD)"
          },
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthlyKPIs"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/error-by-horizon": {
      "get": {
        "tags": [
          "V1 Analytics & Monitoring"
        ],
        "summary": "Get forecast error stratified across lead-time horizon buckets",
        "description": "Evaluates error metrics across lead time windows (0-6h, 6-12h, ..., 60-66.5h). Operates on ALL pre-delivery revisions by default, or on the D-1 decision snapshot.",
        "operationId": "get_error_by_horizon_api_v1_error_by_horizon_get",
        "parameters": [
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Data source: 'all' (all pre-delivery revisions) or 'decision' (D-1 decision snapshot)",
              "examples": [
                "all",
                "decision"
              ],
              "default": "all",
              "title": "Source"
            },
            "description": "Data source: 'all' (all pre-delivery revisions) or 'decision' (D-1 decision snapshot)"
          },
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorByHorizonResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/error-by-hour": {
      "get": {
        "tags": [
          "V1 Analytics & Monitoring"
        ],
        "summary": "Get diurnal forecast error profile across hours of day (0-23)",
        "description": "Evaluates mean actual, mean forecast, bias, MAE, and RMSE for each clock hour 0 to 23.",
        "operationId": "get_error_by_hour_api_v1_error_by_hour_get",
        "parameters": [
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorByHourResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/risk/safe-wind": {
      "get": {
        "tags": [
          "V1 Analytics & Monitoring"
        ],
        "summary": "Calculate 'Safe Wind to Count On' and backup thermal procurement",
        "description": "Derates day-ahead wind commitments by a historical shortfall quantile (default P90). Provides buffer decomposition (systematic bias vs residual quantile), prior-days vs in-sample toggle, and empirical backtest coverage.",
        "operationId": "get_safe_wind_api_v1_risk_safe_wind_get",
        "parameters": [
          {
            "name": "quantile",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 0.999,
              "minimum": 0.5,
              "description": "Target reliability quantile (e.g. 0.90 for P90)",
              "examples": [
                0.9,
                0.95,
                0.99
              ],
              "default": 0.9,
              "title": "Quantile"
            },
            "description": "Target reliability quantile (e.g. 0.90 for P90)"
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(in_sample|prior_days)$",
              "description": "Shortfall history mode: 'in_sample' (full month) or 'prior_days' (only days prior to target)",
              "examples": [
                "in_sample",
                "prior_days"
              ],
              "default": "in_sample",
              "title": "Mode"
            },
            "description": "Shortfall history mode: 'in_sample' (full month) or 'prior_days' (only days prior to target)"
          },
          {
            "name": "delivery_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Target delivery date in ISO format (YYYY-MM-DD) inside January 2026",
              "examples": [
                "2026-01-15"
              ],
              "default": "2026-01-15",
              "title": "Delivery Date"
            },
            "description": "Target delivery date in ISO format (YYYY-MM-DD) inside January 2026"
          },
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SafeWindSummary"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/diagnostics/metrics": {
      "get": {
        "tags": [
