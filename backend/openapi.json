              "examples": [
                "2026-01-15"
              ],
              "default": "2026-01-15",
              "title": "Delivery Date"
            },
            "description": "Target delivery date in ISO format (YYYY-MM-DD) inside January 2026"
          },
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastSnapshotResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
