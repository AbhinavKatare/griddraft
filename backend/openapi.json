{
  "openapi": "3.1.0",
  "info": {
    "title": "UK Wind Forecast Monitoring",
    "description": "### UK Wind Forecast Monitoring & Day-Ahead Trading Analytics\n\nProduction REST API for power traders, quantitatively evaluating National Grid ESO / Elexon BMRS WINDFOR generation forecasts against FUELHH metered outturn.\n\n**Key Capabilities:**\n- Point-in-time forecast selection at configurable decision cutoffs (e.g. D-1 09:00)\n- Causal information leakage prevention (publishTime <= cutoff <= startTime)\n- Outturn-normalised accuracy metrics (NMAE by mean actual and max observed actual, sMAPE)\n- Downside shortfall risk analysis and implied backup thermal procurement\n- Lead-time horizon and diurnal hour-of-day error profiles\n",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/meta": {
      "get": {
        "tags": [
          "V1 Analytics & Monitoring"
        ],
        "summary": "Get dataset coverage and ingestion metadata",
        "description": "Returns available date boundaries, cache status, and raw row counts for actuals and forecasts.",
        "operationId": "get_metadata_api_v1_meta_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetaResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/timeseries": {
      "get": {
        "tags": [
          "V1 Analytics & Monitoring"
        ],
        "summary": "Query aligned actual and forecast time-series with downsampling",
        "description": "Returns actual wind generation alongside decision-time forecast and latest forecast. Supports downsampling aggregation via ?resolution=30m|1h|3h.",
        "operationId": "get_timeseries_api_v1_timeseries_get",
        "parameters": [
          {
            "name": "resolution",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(30m|1h|3h)$",
              "description": "Temporal resolution: '30m' (native), '1h' (hourly average), or '3h' (3-hour average)",
              "examples": [
                "30m",
                "1h",
                "3h"
              ],
              "default": "30m",
              "title": "Resolution"
            },
            "description": "Temporal resolution: '30m' (native), '1h' (hourly average), or '3h' (3-hour average)"
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Start delivery date (YYYY-MM-DD) within January 2026",
              "examples": [
                "2026-01-01"
              ],
              "default": "2026-01-01",
              "title": "Start Date"
            },
            "description": "Start delivery date (YYYY-MM-DD) within January 2026"
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "End delivery date (YYYY-MM-DD) within January 2026",
              "examples": [
                "2026-01-31"
              ],
              "default": "2026-01-31",
              "title": "End Date"
            },
            "description": "End delivery date (YYYY-MM-DD) within January 2026"
          },
          {
            "name": "decision_time",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format",
              "examples": [
                "09:00",
                "08:30",
                "11:00"
              ],
              "default": "09:00",
              "title": "Decision Time"
            },
            "description": "Day-ahead auction decision cutoff time on D-1 in HH:MM format"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TimeseriesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
