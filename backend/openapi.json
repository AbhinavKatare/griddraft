                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BacktestResult": {
        "properties": {
          "target_coverage_pct": {
            "type": "number",
            "title": "Target Coverage Pct",
            "description": "Nominal confidence quantile percentage (e.g. 90%)"
          },
          "empirical_coverage_pct": {
            "type": "number",
            "title": "Empirical Coverage Pct",
            "description": "Observed percentage of intervals where actual >= safe_wind"
          },
          "total_evaluated_periods": {
            "type": "integer",
            "title": "Total Evaluated Periods",
            "description": "Number of periods with actuals evaluated"
          },
          "breach_count": {
            "type": "integer",
            "title": "Breach Count",
            "description": "Number of intervals where actual fell below safe_wind"
          },
          "max_breach_mw": {
            "type": "number",
            "title": "Max Breach Mw",
            "description": "Maximum deficit observed: max(0, safe_wind - actual) in MW"
          },
          "mean_breach_mw": {
            "type": "number",
            "title": "Mean Breach Mw",
            "description": "Average deficit during breach intervals in MW"
          }
        },
        "type": "object",
        "required": [
          "target_coverage_pct",
          "empirical_coverage_pct",
          "total_evaluated_periods",
          "breach_count",
          "max_breach_mw",
          "mean_breach_mw"
        ],
        "title": "BacktestResult",
        "description": "Empirical backtest evaluating whether actual outturn covered safe wind commitments."
      },
      "BufferDecomposition": {
        "properties": {
          "systematic_bias_mw": {
            "type": "number",
            "title": "Systematic Bias Mw",
            "description": "Mean historical shortfall component in MW"
          },
          "residual_quantile_mw": {
            "type": "number",
            "title": "Residual Quantile Mw",
            "description": "Residual quantile component above mean bias in MW"
          },
          "total_buffer_mw": {
            "type": "number",
            "title": "Total Buffer Mw",
            "description": "Total combined shortfall buffer in MW"
          }
        },
        "type": "object",
        "required": [
          "systematic_bias_mw",
          "residual_quantile_mw",
          "total_buffer_mw"
        ],
        "title": "BufferDecomposition",
        "description": "Decomposition of the total buffer into systematic bias and stochastic residual."
      },
      "ErrorByHorizonResponse": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "Revisions source: 'all_pre_delivery_revisions' or 'decision_time_snapshot'"
          },
          "total_observations": {
            "type": "integer",
            "title": "Total Observations"
          },
          "buckets": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Buckets"
          }
        },
        "type": "object",
        "required": [
          "source",
          "total_observations",
          "buckets"
        ],
        "title": "ErrorByHorizonResponse",
        "description": "Stratified forecast accuracy across lead time horizon buckets."
      },
      "ErrorByHourResponse": {
        "properties": {
          "hours": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Hours"
          }
        },
        "type": "object",
        "required": [
          "hours"
        ],
        "title": "ErrorByHourResponse",
        "description": "Diurnal error profile across hours of the day (0-23)."
      },
      "ForecastSnapshotResponse": {
        "properties": {
          "delivery_date": {
            "type": "string",
            "title": "Delivery Date"
          },
          "decision_time_str": {
            "type": "string",
            "title": "Decision Time Str"
          },
          "cutoff_time": {
            "type": "string",
            "title": "Cutoff Time"
          },
          "total_periods": {
            "type": "integer",
            "title": "Total Periods"
          },
          "matched_periods": {
            "type": "integer",
            "title": "Matched Periods"
          },
          "periods": {
            "items": {
              "$ref": "#/components/schemas/HalfHourForecastPoint"
            },
            "type": "array",
            "title": "Periods"
          }
        },
        "type": "object",
        "required": [
          "delivery_date",
          "decision_time_str",
          "cutoff_time",
          "total_periods",
          "matched_periods",
          "periods"
        ],
        "title": "ForecastSnapshotResponse",
        "description": "Point-in-time forecast snapshot for a given delivery day and decision cutoff."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HalfHourForecastPoint": {
        "properties": {
          "settlement_date": {
            "type": "string",
            "title": "Settlement Date",
            "description": "Settlement date (YYYY-MM-DD)"
          },
          "settlement_period": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Settlement Period",
            "description": "Settlement period (1-48/50)"
          },
          "start_time": {
            "type": "string",
            "title": "Start Time",
            "description": "Half-hour start timestamp ISO-8601 UTC"
          },
          "actual_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Mw",
            "description": "Actual wind generation from FUELHH (MW)"
          },
          "forecast_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forecast Mw",
            "description": "Latest forecast available at decision time (MW)"
          },
          "latest_publish_time": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latest Publish Time",
            "description": "Publish time of the selected forecast"
          },
          "lead_time_hours": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lead Time Hours",
            "description": "Hours between publish time and delivery start"
          },
          "error_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Mw",
            "description": "Signed error = Forecast - Actual (MW)"
          },
          "abs_error_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abs Error Mw",
            "description": "Absolute error |Forecast - Actual| (MW)"
          },
          "shortfall_mw": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shortfall Mw",
            "description": "Shortfall when forecast > actual, causing long day-ahead risk (MW)"
          },
          "has_forecast": {
            "type": "boolean",
            "title": "Has Forecast",
            "description": "Whether a forecast was available prior to cutoff",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "settlement_date",
          "settlement_period",
          "start_time"
