# ==============================================================================
# Git Ignore Configuration for Power Forecast Monorepo
# ==============================================================================

# Operating System
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# IDE & Editors
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Quality Tooling (Python)
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Node & Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/dist/
frontend/dist-ssr/
frontend/*.tsbuildinfo
.eslintcache

# Data Caching & Artifacts
# Bundle canonical January 2026 Parquet cache in image
!data/cache/*.parquet
!backend/data/cache/*.parquet
!backend/data/cache/*.json
!backend/data/cache/.gitkeep

# Jupyter Notebooks Checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Local Execution Logs
*.log
